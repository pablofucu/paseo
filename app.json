{
  "expo": {
    "name": "Paseo",
    "slug": "paseo",
    "scheme": "paseo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.paseo.tours",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "location"
        ]
      }
    },
    "android": {
      "package": "app.paseo.tours",
      "adaptiveIcon": {
        "backgroundColor": "#1D2B4F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D2B4F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 112
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Paseo usa tu ubicación para guiarte entre las paradas del tour y avisarte cuando llegas.",
          "locationAlwaysAndWhenInUsePermission": "Paseo usa tu ubicación, también con la pantalla apagada, para avisarte cuando llegas a cada parada.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-sharing",
      "./modules/paseo-ble/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
